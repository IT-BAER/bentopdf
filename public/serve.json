{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/en/:path", "destination": "/en/:path.html" },
    { "source": "/de/:path", "destination": "/de/:path.html" },
    { "source": "/es/:path", "destination": "/es/:path.html" },
    { "source": "/fr/:path", "destination": "/fr/:path.html" },
    { "source": "/it/:path", "destination": "/it/:path.html" },
    { "source": "/pt/:path", "destination": "/pt/:path.html" },
    { "source": "/tr/:path", "destination": "/tr/:path.html" },
    { "source": "/id/:path", "destination": "/id/:path.html" },
    { "source": "/vi/:path", "destination": "/vi/:path.html" },
    { "source": "/zh/:path", "destination": "/zh/:path.html" },
    { "source": "/zh-TW/:path", "destination": "/zh-TW/:path.html" },
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/de", "destination": "/de/index.html" },
    { "source": "/es", "destination": "/es/index.html" },
    { "source": "/fr", "destination": "/fr/index.html" },
    { "source": "/it", "destination": "/it/index.html" },
    { "source": "/pt", "destination": "/pt/index.html" },
    { "source": "/tr", "destination": "/tr/index.html" },
    { "source": "/id", "destination": "/id/index.html" },
    { "source": "/vi", "destination": "/vi/index.html" },
    { "source": "/zh", "destination": "/zh/index.html" },
    { "source": "/zh-TW", "destination": "/zh-TW/index.html" }
  ],
  "headers": [
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, no-cache, must-revalidate"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "**/*",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
